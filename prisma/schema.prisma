generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  clerkId               String    @unique
  email                 String    @unique
  name                  String
  phone                 String?
  avatar                String?
  role                  UserRole  @default(BUYER)
  district              String?
  state                 String?
  address               String?
  pincode               String?

  businessName          String?
  description           String?

  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?

  totalSales            Int       @default(0)
  totalPurchases        Int       @default(0)
  rating                Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount           Int       @default(0)

  notificationsEnabled  Boolean   @default(true)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  listings              Listing[]
  ordersAsBuyer         Order[]      @relation("BuyerOrders")
  ordersAsSeller        Order[]      @relation("SellerOrders")
  deliveries            Delivery[]
  reviews               Review[]
  notifications         Notification[]
  cartItems             CartItem[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
}

enum UserRole {
  FARMER
  BUYER
  LOGISTICS
  ADMIN
}

model Listing {
  id              String        @id @default(cuid())
  title           String
  description     String
  category        Category
  subcategory     String?

  price           Decimal       @db.Decimal(10, 2)
  unit            String        @default("kg")
  minOrder        Decimal       @default(1) @db.Decimal(10, 2)
  maxQuantity     Decimal?      @db.Decimal(10, 2)
  stockQuantity   Decimal       @default(0) @db.Decimal(10, 2)

  quality         QualityGrade  @default(A)
  isOrganic       Boolean       @default(false)
  organicCertHash String?
  isVerified      Boolean       @default(false)

  district        String
  state           String
  latitude        Float?
  longitude       Float?

  status          ListingStatus @default(ACTIVE)
  availableFrom   DateTime?
  availableUntil  DateTime?
  harvestDate     DateTime?

  images          String[]

  viewCount       Int           @default(0)
  orderCount      Int           @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expiresAt       DateTime?

  sellerId        String
  seller          User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders          Order[]
  reviews         Review[]
  cartItems       CartItem[]

  @@index([category])
  @@index([status])
  @@index([district])
  @@index([createdAt])
  @@index([sellerId])
}

enum Category {
  VEGETABLES
  FRUITS
  SPICES
  GRAINS
  DAIRY
  HERBS
  BAMBOO_PRODUCTS
  HANDICRAFTS
  TEA
  HONEY
  OTHER
}

enum QualityGrade {
  A_PLUS
  A
  B
  C
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  EXPIRED
  SUSPENDED
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique @default(cuid())

  buyerId             String
  buyer               User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId            String
  seller              User          @relation("SellerOrders", fields: [sellerId], references: [id])

  listingId           String
  listing             Listing       @relation(fields: [listingId], references: [id])
  quantity            Decimal       @db.Decimal(10, 2)
  unitPrice           Decimal       @db.Decimal(10, 2)
  totalPrice          Decimal       @db.Decimal(10, 2)

  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       String?
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?       @unique

  deliveryAddress     String
  deliveryDistrict    String
  deliveryState       String
  deliveryPincode     String?
  deliveryPhone       String

  confirmedAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?

  notes               String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  delivery            Delivery?
  tracking            TrackingEvent[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Delivery {
  id                  String          @id @default(cuid())
  orderId             String          @unique
  order               Order           @relation(fields: [orderId], references: [id])

  riderId             String
  rider               User            @relation(fields: [riderId], references: [id])

  pickupLocation      String
  dropLocation        String
  estimatedDistance   Float?
  estimatedTime       Int?

  terrainType         TerrainType     @default(MIXED)
  difficultyLevel     Int             @default(1)

  status              DeliveryStatus  @default(ASSIGNED)
  assignedAt          DateTime?
  pickedUpAt          DateTime?
  completedAt         DateTime?

  currentLocation     String?
  lastLocationUpdate  DateTime?

  baseFare            Decimal         @db.Decimal(10, 2)
  terrainBonus        Decimal         @default(0) @db.Decimal(10, 2)
  totalEarnings       Decimal         @db.Decimal(10, 2)

  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([riderId])
  @@index([status])
}

enum TerrainType {
  PLAIN
  HILLY
  MOUNTAINOUS
  MIXED
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  NEAR_DESTINATION
  DELIVERED
  FAILED
  CANCELLED
}

model TrackingEvent {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])

  status      String
  location    String?
  description String
  timestamp   DateTime  @default(now())

  @@index([orderId])
  @@index([timestamp])
}

model Review {
  id          String    @id @default(cuid())
  rating      Int
  comment     String?

  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id])

  reviewerId  String
  reviewer    User      @relation(fields: [reviewerId], references: [id])

  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([listingId, reviewerId])
  @@index([listingId])
  @@index([reviewerId])
}

model Notification {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])

  type        NotificationType
  title       String
  message     String
  data        Json?

  isRead      Boolean           @default(false)
  readAt      DateTime?

  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([isRead])
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  NEW_MESSAGE
  PRICE_DROP
  LISTING_EXPIRING
  PAYMENT_RECEIVED
  DELIVERY_ASSIGNED
  REVIEW_RECEIVED
}

model Inquiry {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  status      String    @default("PENDING")
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

model AppConfig {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  updatedAt   DateTime  @updatedAt
}

model CartItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity    Decimal   @db.Decimal(10, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, listingId])
  @@index([userId])
}